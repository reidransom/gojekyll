---
# Search index — one JSON record per docs page, consumed by /js/search.js.
permalink: /search-data.json
---
[
{%- for doc in site.docs %}
  {
    "title": {{ doc.title | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "text": {{ doc.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
